# AXON configuration. Copy to .env and fill in what you need.
# AXON auto-detects the provider from whichever key is present.

# --- Anthropic (native Messages API) ---
# AXON_ANTHROPIC_API_KEY=sk-ant-...
# AXON_ANTHROPIC_BASE=https://api.anthropic.com/v1

# --- OpenAI / any OpenAI-compatible endpoint ---
# AXON_API_KEY=sk-...
# AXON_BASE_URL=https://api.openai.com/v1

# --- Local models (Ollama / vLLM) — no key required ---
# AXON_BASE_URL=http://localhost:11434/v1     # ollama
# AXON_BASE_URL=http://localhost:8000/v1      # vllm

# --- Where the audit ledger is written ---
# AXON_LEDGER=/var/axon/audit/ledger.jsonl
